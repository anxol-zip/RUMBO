# Plantilla de /etc/rumbo/api.env en la VM (root:rumbo, chmod 640). Nunca subir el archivo real.
# Producción usa rumbo-demo (Supabase).

DATABASE_URL=
RUMBO_AMBIENTE=demo
SUPABASE_URL=
ORS_API_KEY=
TOMTOM_API_KEY=

# 1 = las sesiones nuevas se marcan como demo (RN_11). Decidir antes de abrirlo al público.
PUEBLA_DEMO=0
# Tareas cada hora (clima, afluencia) y tráfico cada 30 min.
PUEBLA_TAREAS=1
# Sin rewrite de Vercel haría falta el dominio del frontend; con rewrite, /api es del mismo origen.
# CORS_ORIGINS=https://<proyecto>.vercel.app
