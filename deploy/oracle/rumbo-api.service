# API de RUMBO como servicio de systemd en la VM de Oracle Cloud.
# Instalar: sudo cp deploy/oracle/rumbo-api.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now rumbo-api
# Logs:     journalctl -u rumbo-api -f
#
# Supone el repo clonado en /opt/rumbo (dueño: usuario rumbo) y `uv sync --frozen` ya corrido en
# /opt/rumbo/backend. Las claves van en /etc/rumbo/api.env (root:rumbo, chmod 640), nunca en el repo.

[Unit]
Description=RUMBO API (FastAPI + uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rumbo
Group=rumbo
WorkingDirectory=/opt/rumbo/backend
EnvironmentFile=/etc/rumbo/api.env
# El backend usa datetime.now() sin zona: la hora del servidor tiene que ser la de Puebla.
Environment=TZ=America/Mexico_City
# Solo escucha en local: Caddy es lo único expuesto a internet.
ExecStart=/opt/rumbo/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5

# Endurecimiento: sin privilegios nuevos y sistema de archivos de solo lectura salvo data/ (ChromaDB).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/rumbo/backend/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
