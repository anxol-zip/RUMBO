# Copia este archivo como backend/.env y llena los valores. backend/.env NO se sube a git.
# Detalle de cada variable: INSTALACION.md

# --- Base de datos (Supabase) ---
# URL del "Session pooler" (puerto 5432): Supabase → proyecto → Connect → Session pooler.
DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres
# dev o demo. herramientas/bd_desarrollo.py se niega a correr con demo.
RUMBO_AMBIENTE=dev

# Base donde pytest crea esquemas temporales (normalmente la misma URL de rumbo-dev).
# Si falta, las pruebas que usan base se saltan con aviso.
# DATABASE_URL_PRUEBAS=

# Solo para la prueba de seguridad (Supabase → Project settings → API Keys).
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Servicios externos ---
ORS_API_KEY=
TOMTOM_API_KEY=

# --- Ollama (opcionales; estos son los valores por omisión) ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODELO=qwen3:8b

# --- Al levantar la API (opcionales) ---
# PUEBLA_DEMO=1        marca las sesiones como demo (stand)
# PUEBLA_TAREAS=0      apaga la actualización cada hora
# CORS_ORIGINS=http://localhost:5173
