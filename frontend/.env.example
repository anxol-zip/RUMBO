# Copia este archivo como frontend/.env.local (no se sube a git: *.local está en .gitignore).
# Sin estas variables la app funciona igual, pero sin cuentas (no aparece "Iniciar sesión").
# Supabase → Project settings → API Keys. La clave "publishable" es pública: puede ir en el navegador.
# Ojo: `npm run build` mete estos valores en el build. El de la Expo se compila con los de rumbo-demo.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
